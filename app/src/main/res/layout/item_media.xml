<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/media_grid_size"
    android:layout_height="@dimen/media_grid_size">

    <ImageView
        android:id="@+id/ivMedia"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@color/divider"
        android:contentDescription="@string/place_photos" />

    <!-- Audio overlay icon -->
    <ImageView
        android:id="@+id/ivAudioIcon"
        android:layout_width="@dimen/icon_large"
        android:layout_height="@dimen/icon_large"
        android:layout_gravity="center"
        android:src="@android:drawable/ic_lock_silent_mode"
        android:contentDescription="@string/place_voice_notes"
        android:visibility="gone" />

    <!-- Play overlay for video -->
    <ImageView
        android:id="@+id/ivPlayOverlay"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:src="@android:drawable/ic_media_play"
        android:contentDescription="Play"
        android:visibility="gone" />

</FrameLayout>
